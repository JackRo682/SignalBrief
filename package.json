{
  "name": "signalbrief",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "npm run dev --workspace @signalbrief/web",
    "lint": "npm run lint --workspace @signalbrief/web",
    "format": "prettier --write apps/web package.json .github/workflows/ci.yml",
    "format:check": "prettier --check apps/web package.json .github/workflows/ci.yml",
    "typecheck": "npm run typecheck --workspace @signalbrief/web",
    "test": "npm run test --workspace @signalbrief/web",
    "build": "npm run build --workspace @signalbrief/web"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
