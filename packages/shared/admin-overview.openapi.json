{
  "openapi": "3.1.0",
  "info": {
    "title": "SignalBrief Administrator Overview API",
    "version": "1.0.0",
    "description": "One-page operational overview of existing consented activity and hourly API telemetry. No new tracking or consent changes."
  },
  "servers": [
    {
      "url": "https://signalbrief.online"
    }
  ],
  "x-zod-source": "apps/web/src/admin-logs/overview-contracts.ts",
  "x-handler-source": "apps/web/src/app/api/admin/overview/route.ts",
  "paths": {
    "/api/admin/overview": {
      "post": {
        "operationId": "readAdminOverview",
        "summary": "Read all operational metrics on the administrator page",
        "description": "Requires a verified live administrator session and MFA when enrolled. Dates are inclusive Asia/Seoul calendar days, maximum 90 days. API request aggregates cover at most 30 days and include administrators. Product data honors current consent and include_admin. Activation is current onboarding completion among newly created consented profiles in the selected period. Retention is exact-day, first-observed-view based; only complete return days are eligible. Session gaps are 30 minutes. Signup conversion is uninstrumented. Responses use private, no-store and Vary: Authorization. Safe audit metadata records the read.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminOverviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated current measurements; missing denominators and uninstrumented signup are null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOverviewResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked authentication."
          },
          "403": {
            "description": "Administrator membership, MFA or account verification required."
          },
          "413": {
            "description": "Body exceeds 4096 bytes."
          },
          "415": {
            "description": "JSON required."
          },
          "422": {
            "description": "Invalid dates, interval or settings."
          },
          "429": {
            "description": "Rate limit; Retry-After is present."
          },
          "502": {
            "description": "Invalid data-access response."
          },
          "503": {
            "description": "Authentication, permission or metrics service unavailable."
          }
        }
      }
    }
  },
