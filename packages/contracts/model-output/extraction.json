        "content_type": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Content Type",
          "type": "string"
        },
        "document_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Document Id",
          "type": "string"
        },
        "first_seen_at": {
          "format": "date-time",
