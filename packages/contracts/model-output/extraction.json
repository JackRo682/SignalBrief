          "title": "First Seen At",
          "type": "string"
        },
        "issuer_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Issuer Id",
          "type": "string"
        },
        "language": {
          "maxLength": 16000,
