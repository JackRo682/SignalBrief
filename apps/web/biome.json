{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["**", "!!**/.next", "!!**/node_modules", "!next-env.d.ts"]
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" },
