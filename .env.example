# LOCAL DEMO ONLY. Copy to .env. Never commit .env or reuse these values in production.
SB_ENVIRONMENT=development
SB_DEMO_MODE=true
SB_DEMO_ADMIN=false
SB_DEMO_SEED_ON_START=true
SB_AUTH_MODE=demo
SB_DEMO_JWT_SECRET=LOCAL-ONLY-SYNTHETIC-DATA-DO-NOT-DEPLOY-CHANGE-ME
SB_DATABASE_URL=sqlite:///./var/signalbrief.db
SB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SB_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SB_ADMIN_USER_IDS=
SB_STORAGE_MODE=local
SB_STORAGE_PATH=var/raw
SB_STORAGE_BUCKET=signalbrief-raw
# Backend only. Production requires Supabase URL + privileged server storage key.
SB_SUPABASE_URL=
SB_SUPABASE_SERVICE_KEY=
SB_DART_API_KEY=
# Required for real SEC ingestion, e.g. SignalBrief your-real-contact@example.com
SB_SEC_USER_AGENT=
SB_HTTP_TIMEOUT=20
SB_MAX_DOWNLOAD_BYTES=25000000
SB_MAX_RETRIES=3
SB_SEC_REQUESTS_PER_SECOND=2
SB_DART_REQUESTS_PER_SECOND=1
SB_OPENAI_API_KEY=
# Choose an actually available model supporting Responses strict structured output.
SB_OPENAI_MODEL=
SB_OPENAI_TIMEOUT=60
# Omit unset price variables entirely: unknown cost is null, not a fictitious zero.
# SB_OPENAI_INPUT_USD_PER_MILLION=...
# SB_OPENAI_OUTPUT_USD_PER_MILLION=...
SB_AI_DAILY_REQUESTS=1000
# Lifetime USD reservation ceiling shared by Python processes using this DB.
# Zero disables paid model calls. Set positive, current model price rates above.
# Does not set an account-wide OpenAI billing limit or include separate Edge calls.
SB_AI_TOTAL_BUDGET_USD=0
SB_MAX_LLM_CHUNKS=60
SB_AUTO_PUBLISH_VALIDATED=false
SB_POSTHOG_PROJECT_KEY=
SB_POSTHOG_HOST=https://us.i.posthog.com
SB_EMBEDDING_MODEL=
# SB_EMBEDDING_INPUT_USD_PER_MILLION=...
SB_SENTRY_DSN=
SB_API_REQUESTS_PER_MINUTE=120
SB_WORKER_LEASE_SECONDS=240
SB_WORKER_POLL_SECONDS=2
SB_LOG_LEVEL=INFO
